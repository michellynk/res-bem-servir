# Copie este arquivo para `.env` e preencha os valores.
# NUNCA commite o `.env`: ele contém dados sensíveis (ADR-008).

# --- Banco de dados (Etapa 1) ---
# Local, usando o docker-compose.yml:
DATABASE_URL="postgresql://rbs:rbs@localhost:5432/rbs?schema=public"

# --- Autenticação (Etapa 1) ---
# Gere com: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET=""

# --- WhatsApp Cloud API (Etapa 6) ---
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# --- Pix (RN-79) — exibido pelo bot quando o cliente escolhe Pix ---
PIX_KEY=""
PIX_RECEIVER_NAME=""

# --- Geral ---
TZ="America/Sao_Paulo"
